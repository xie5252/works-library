{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "works-library",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // 前端静态资源：assets 优先；/api/* 与 /media/* 强制走 Worker
  // not_found_handling 让 /admin、/work/:slug 等页面路由返回 index.html（SPA）
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "works-db",
      "database_id": "221f88dd-bf54-4e67-9942-81f0de956ec3"
    }
  ],
  // 媒体存 R2（免费 10GB，零出口流量费）
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "works-media"
    }
  ],
  // pages.dev / 自定义域名均为 HTTPS，cookie 加 secure
  "vars": {
    "COOKIE_SECURE": "1"
  },
  "observability": {
    "enabled": true
  }
}
